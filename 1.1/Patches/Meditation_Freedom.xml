	<!-- Artistic - Sculptures -->
			
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[@Name = "SculptureBase"]/comps/li[@Class = "CompProperties_MeditationFocus"]</xpath>
				<value>
					<li Class="CompProperties_MeditationFocus">
						<statDef>MeditationFocusStrength</statDef>
						<focusTypes>
							<li>Dignified</li>
							<li>Natural</li>
							<li>Artistic</li>
							<li>Morbid</li>
							<li>Minimal</li>
						</focusTypes>
						<offsets>
							<li Class="FocusStrengthOffset_Quality">
								<curve>
									<points>
										<li>(0,0.30)</li> <!-- awful -->
										<li>(1,0.30)</li> <!-- poor -->
										<li>(2,0.30)</li> <!-- normal -->
										<li>(3,0.30)</li> <!-- good -->
										<li>(4,0.30)</li> <!-- excellent -->
										<li>(5,0.30)</li> <!-- masterwork -->
										<li>(6,0.30)</li> <!-- legendary -->
									</points>
								</curve>
							</li>
						</offsets>
					</li>
				</value>
			</li>
			
		</operations>
	</Operation>
	
	
	
	
	
