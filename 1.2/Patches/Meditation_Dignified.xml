<?xml version="1.0" encoding="utf-8"?>

<Patch>

	<Operation Class="PatchOperationSequence">
		<success>Always</success>
		<operations>
	
	<!-- Dignified - Throne -->
			
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "Throne"]/statBases/MeditationFocusStrength</xpath>
				<value>
					<MeditationFocusStrength>0.4</MeditationFocusStrength>
				</value>
			</li>
			
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "Throne"]/comps/li[@Class = "CompProperties_MeditationFocus"]</xpath>
				<value>
					<li Class="CompProperties_MeditationFocus">
						<statDef>MeditationFocusStrength</statDef>
						<focusTypes>
							<li>Dignified</li>
							<li>Natural</li>
							<li>Artistic</li>
							<li>Morbid</li>
							<li>Minimal</li>
							<li>Flame</li>
						</focusTypes>
					</li>
				</value>
			</li>
			
	<!-- Dignified - Grand Throne -->
			
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "GrandThrone"]/statBases/MeditationFocusStrength</xpath>
				<value>
					<MeditationFocusStrength>0.4</MeditationFocusStrength>
				</value>
			</li>
			
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "GrandThrone"]/comps/li[@Class = "CompProperties_MeditationFocus"]</xpath>
				<value>
					<li Class="CompProperties_MeditationFocus">
						<statDef>MeditationFocusStrength</statDef>
						<focusTypes>
							<li>Dignified</li>
							<li>Natural</li>
							<li>Artistic</li>
							<li>Morbid</li>
							<li>Minimal</li>
							<li>Flame</li>
						</focusTypes>
					</li>
				</value>
			</li>
			
		</operations>
	</Operation>
	
</Patch>