<?xml version="1.0" encoding="utf-8"?>

<Patch>

	<Operation Class="PatchOperationSequence">
		<success>Always</success>
		<operations>
			
			<li Class="PatchOperationTest">
				<xpath>/Defs/ThingDef[defName = "BoneChair"]</xpath>
			</li>
	
	<!-- Bone Chair -->
			
			<li Class="PatchOperationAdd">
				<xpath>/Defs/ThingDef[defName = "BoneChair"]/statBases</xpath>
				<value>
					<MeditationFocusStrength>0.4</MeditationFocusStrength>
				</value>
			</li>
			
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "BoneChair"]/comps/li[@Class = "CompProperties_MeditationFocus"]</xpath>
				<value>
					<li Class="CompProperties_MeditationFocus">
						<statDef>MeditationFocusStrength</statDef>
						<focusTypes>
							<li>Dignified</li>
							<li>Natural</li>
							<li>Artistic</li>
							<li>Morbid</li>
							<li>Minimal</li>
							<li>Flame</li>
						</focusTypes>
					</li>
				</value>
			</li>
			
	<!-- Bone Throne -->
			
			<li Class="PatchOperationAdd">
				<xpath>/Defs/ThingDef[defName = "BoneThrone"]/statBases</xpath>
				<value>
					<MeditationFocusStrength>0.4</MeditationFocusStrength>
				</value>
			</li>
			
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "BoneThrone"]/comps/li[@Class = "CompProperties_MeditationFocus"]</xpath>
				<value>
					<li Class="CompProperties_MeditationFocus">
						<statDef>MeditationFocusStrength</statDef>
						<focusTypes>
							<li>Dignified</li>
							<li>Natural</li>
							<li>Artistic</li>
							<li>Morbid</li>
							<li>Minimal</li>
							<li>Flame</li>
						</focusTypes>
					</li>
				</value>
			</li>
			
		</operations>
	</Operation>
	
</Patch>