<?xml version="1.0" encoding="utf-8"?>

<Patch>
	
	<Operation Class="PatchOperationSequence">
		<success>Always</success>
		<operations>
	
	<!-- Flame - Campfire -->
			
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "Campfire"]/comps/li[@Class = "CompProperties_MeditationFocus"]</xpath>
				<value>
					<li Class="CompProperties_MeditationFocus">
						<statDef>MeditationFocusStrength</statDef>
						<focusTypes>
							<li>Dignified</li>
							<li>Natural</li>
							<li>Artistic</li>
							<li>Morbid</li>
							<li>Minimal</li>
							<li>Flame</li>
						</focusTypes>
						<offsets>
							<li Class="FocusStrengthOffset_Lit">
								<offset>0.40</offset>
							</li>
						</offsets>
					</li>
				</value>
			</li>
			
		</operations>
	</Operation>
	
	
	
	
	
	
