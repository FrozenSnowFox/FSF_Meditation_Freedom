						<statDef>MeditationFocusStrength</statDef>
						<focusTypes>
							<li>Dignified</li>
							<li>Natural</li>
							<li>Artistic</li>
							<li>Morbid</li>
							<li>Minimal</li>
							<li>Flame</li>
						</focusTypes>
					</li>
				</value>
			</li>
			
	<!-- Artistic - Stele Grand -->
			
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "SteleGrand"]/statBases/MeditationFocusStrength</xpath>
				<value>
					<MeditationFocusStrength>0.4</MeditationFocusStrength>
				</value>
			</li>
			
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "SteleGrand"]/comps/li[@Class = "CompProperties_MeditationFocus"]</xpath>
				<value>
					<li Class="CompProperties_MeditationFocus">
						<statDef>MeditationFocusStrength</statDef>
