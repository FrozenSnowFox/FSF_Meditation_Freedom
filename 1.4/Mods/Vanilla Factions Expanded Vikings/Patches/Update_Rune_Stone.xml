<?xml version="1.0" encoding="utf-8"?>

<Patch>

	<Operation Class="PatchOperationSequence">
		<success>Normal</success>
		<operations>

	<!-- Update Rune Stone -->
			
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "VFEV_RuneStone"]/placeWorkers</xpath>
				<value>
					<placeWorkers>
						<li>PlaceWorker_ArtificialBuildingsNear</li>
						<li>PlaceWorker_MeditationOffsetBuildingsNear</li>
					</placeWorkers>
				</value>
			</li>
			
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "VFEV_RuneStone"]/comps/li[@Class = "CompProperties_MeditationFocus"]/offsets/li[@Class = "FocusStrengthOffset_ArtificialBuildings"]/radius</xpath>
				<value>
					<radius>0</radius>
				</value>
			</li>
			
		</operations>
	</Operation>
	
</Patch>