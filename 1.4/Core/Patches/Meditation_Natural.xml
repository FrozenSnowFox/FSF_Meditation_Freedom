<?xml version="1.0" encoding="utf-8"?>

<Patch>
	
	<Operation Class="PatchOperationSequence">
		<success>Normal</success>
		<operations>
			
	<!-- Natural - Remove Nature Psycaster Build Requirement -->						
			
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[@Name = "NatureShrineBase"]/placeWorkers</xpath>
				<value>
					<placeWorkers>
						<li>PlaceWorker_ArtificialBuildingsNear</li>
						<li>PlaceWorker_MeditationOffsetBuildingsNear</li>
					</placeWorkers>
				</value>
			</li>
	
	<!-- Natural - Small Nature Shrine -->
			
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "NatureShrine_Small"]/comps/li[@Class = "CompProperties_MeditationFocus"]/offsets/li[@Class = "FocusStrengthOffset_ArtificialBuildings"]/radius</xpath>
				<value>
					<radius>0</radius>
				</value>
			</li>
			
	<!-- Natural - Large Nature Shrine -->
			
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "NatureShrine_Large"]/comps/li[@Class = "CompProperties_MeditationFocus"]/offsets/li[@Class = "FocusStrengthOffset_ArtificialBuildings"]/radius</xpath>
				<value>
					<radius>0</radius>
				</value>
			</li>
			
	<!-- Natural - Animus Stone -->
			
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "AnimusStone"]/comps/li[@Class = "CompProperties_MeditationFocus"]/offsets/li[@Class = "FocusStrengthOffset_ArtificialBuildings"]/radius</xpath>
				<value>
					<radius>0</radius>
				</value>
			</li>
			
		</operations>
	</Operation>
	
</Patch>