<?xml version="1.0" encoding="utf-8"?>
<Defs>
  
	<ThingDef ParentName="BuildingBase">
		<defName>FSFMeditationFocus</defName>
		<label>meditation focus</label>
		<description>Designates a spot for people to focus their attention while meditating.</description>
		<designationCategory>Misc</designationCategory>
		<altitudeLayer>FloorEmplacement</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<statBases>
			<WorkToBuild>0</WorkToBuild>
			<MeditationFocusStrength>0.4</MeditationFocusStrength>
		</statBases>
		<rotatable>false</rotatable>
		<scatterableOnMapGen>false</scatterableOnMapGen>
		<useHitPoints>False</useHitPoints>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
			<artificialForMeditationPurposes>false</artificialForMeditationPurposes>
			<canPlaceOverImpassablePlant>true</canPlaceOverImpassablePlant>
			<isEdifice>false</isEdifice>
			<sowTag>SupportPlantsOnly</sowTag>
		</building>
		<comps>
			<li Class="CompProperties_MeditationFocus">
				<statDef>MeditationFocusStrength</statDef>
				<focusTypes>
					<li>Dignified</li>
					<li>Natural</li>
					<li>Artistic</li>
					<li>Morbid</li>
					<li>Minimal</li>
					<li>Flame</li>
				</focusTypes>
			</li>
    	</comps>
    	<graphicData>
			<texPath>Things/Building/Misc/MeditationSpot</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(0.25,0.25)</drawSize>
		</graphicData>
    	<uiIconScale>3.20</uiIconScale>
  </ThingDef>
  
</Defs>